# Local development placeholders only. Replace together before first DB startup.
POSTGRES_USER=orderflow_dev
POSTGRES_PASSWORD=replace_with_local_password
POSTGRES_DB=orderflow_dev
DATABASE_URL=postgresql://orderflow_dev:replace_with_local_password@127.0.0.1:5432/orderflow_dev
PORT=3000
# Dedicated local test server: the role must have CREATEDB permission.
# Tests create a random database and never migrate/reset the database in this URL.
TEST_DATABASE_ADMIN_URL=postgresql://orderflow_dev:replace_with_local_password@127.0.0.1:5432/postgres
# Explicit development provisioning only. Replace locally before running the command.
NODE_ENV=development
DEV_ADMIN_EMAIL=admin@example.test
DEV_ADMIN_PASSWORD=replace_with_a_unique_admin_passphrase
DEV_OPERATOR_EMAIL=operator@example.test
DEV_OPERATOR_PASSWORD=replace_with_a_unique_operator_passphrase
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_64_random_hex_characters
AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3000,http://127.0.0.1:5173
# Empty for local HTTP; production requires explicit proxy IPs/CIDRs and HTTPS origins.
AUTH_TRUST_PROXY=
# Optional private persistent image directory outside this repository (mode 700).
# PRODUCT_IMAGE_STORAGE_DIR=/absolute/private/path/orderflow-images
