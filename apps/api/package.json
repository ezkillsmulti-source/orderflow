{
  "name": "@orderflow/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build && concurrently --kill-others \"tsc -p tsconfig.build.json --watch\" \"node --watch --env-file-if-exists=../../.env dist/src/main.js\"",
    "build": "pnpm db:generate && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/src/main.js",
    "typecheck": "pnpm db:generate && tsc --noEmit",
    "test": "pnpm db:generate && tsc -p tsconfig.test.json && node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js",
    "test:integration": "pnpm db:generate && tsc -p tsconfig.test.json && node --env-file-if-exists=../../.env --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.integration.config.js --runInBand",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "users:provision:dev": "pnpm build && node --env-file-if-exists=../../.env dist/src/users/provision-main.js"
  },
  "dependencies": {
    "@nestjs/common": "12.2.0",
    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "connect-pg-simple": "10.0.0",
    "dotenv": "17.2.3",
    "express-session": "1.19.0",
    "pg": "8.16.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "12.2.0",
    "@types/connect-pg-simple": "7.0.3",
    "@types/express": "5.0.6",
    "@types/express-session": "1.19.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.1",
    "jest": "30.5.2",
    "prisma": "7.10.1",
    "supertest": "7.1.4"
  }
}
