generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  OPERATOR
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(254)
  passwordHash String
  role         Role
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
}

enum ProductImageState {
  PENDING
  PUBLISHED
  RETIRED
  DELETING
  DELETED
}

model ProductImage {
  id              String            @id @default(uuid()) @db.Uuid
  productId       String            @db.Uuid
  state           ProductImageState @default(PENDING)
  detailWidth     Int?
  detailHeight    Int?
  thumbnailWidth  Int?
  thumbnailHeight Int?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)
  cleanupAfter    DateTime          @db.Timestamptz(3)
  product         Product?

  @@unique([id, productId])
  @@index([state, cleanupAfter])
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  imageId     String?       @unique @db.Uuid
  image       ProductImage? @relation(fields: [imageId], references: [id], onDelete: Restrict)
  sku         String        @unique
  name        String
  description String?
  priceMinor  BigInt        @db.BigInt
  active      Boolean       @default(true)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime      @updatedAt @db.Timestamptz(3)
}

model HttpSession {
  sid    String   @id @db.VarChar(255)
  sess   Json     @db.Json
  expire DateTime @db.Timestamptz(6)

  @@index([expire])
  @@map("http_session")
}

model LoginLimit {
  key    String  @id @db.VarChar(255)
  points Int     @default(0)
  expire BigInt?

  @@index([expire])
  @@map("login_limit")
}
